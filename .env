# =============================================================
# Utsav Cleaners - Environment Variables Template
# =============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# =============================================================


# ── Database ──────────────────────────────────────────────────
# MongoDB Atlas connection string.
# Leave blank to fall back to local data/db.json storage.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/utsavcleaners?retryWrites=true&w=majority


# ── Authentication ────────────────────────────────────────────
# Strong random string used to sign JWT tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret

# Default admin credentials (used only on first-time seed).
# Change these immediately after first login.
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-strong-password


# ── Next.js ───────────────────────────────────────────────────
# The public base URL of your deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment: development | production | test
NODE_ENV=development


# ── Email / Notifications (optional) ──────────────────────────
# SMTP settings for sending booking confirmation emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=noreply@utsavcleaners.com
